    "js:watch": "./scripts/esbuild.sh --minify --watch=forever"
  },
  "type": "module",
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@jarijokinen/consent": "^0.0.8",
