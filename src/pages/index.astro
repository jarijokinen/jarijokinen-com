---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "https://jarijokinen.com/#website",
      "url": "https://jarijokinen.com/",
      "name": "Jari Jokinen",
      "description": "Personal website of software engineer Jari Jokinen"
    },
    {
      "@type": "Person",
      "@id": "https://jarijokinen.com/#jarijokinen",
      "name": "Jari Jokinen",
      "url": "https://jarijokinen.com/",
      "jobTitle": "Software Engineer",
      "description": "Software engineer with 25+ years of experience in web and mobile development, backend services, cloud platforms and advanced integrations.",
      "sameAs": [
        "https://github.com/jarijokinen",
        "https://linkedin.com/in/jarijokinen",
        "https://stackoverflow.com/users/626301/jari-jokinen",
        "https://orcid.org/0009-0005-9267-5324"
      ]
    }
  ]
};
---

<BaseLayout
  title='Jari Jokinen - Software Engineer'
  description='Software engineer with 25+ years of experience in web and mobile development, backend services, cloud platforms and advanced integrations.'
  schema={schema}
  hasHero={true}
>
  <section class="hero">
    <span class="hero-star" aria-hidden="true"></span>
    <div class="container">
      <div class="hero-content">
        <h1><span>Software Engineer</span> from Helsinki</h1>
        <p>
          25+ years of experience - from web and mobile apps to backend 
          services, cloud platforms and advanced integrations.
        </p>
        <div class="hero-cta">
          <a class="button" href="/blog/">Explore My Blog</a>
          <a class="button button--secondary" href="/about/">Read More</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
