---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatter } from '../../lib/date.ts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.created_at.valueOf() - a.data.created_at.valueOf()
);
---
<BaseLayout
  title='Blog'
  description='Blog of software engineer Jari Jokinen'
  type='website'
>
  <div class="postlist">
    {posts.map(post => (
      <article class="postlist-item">
        <h2><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h2>
        <div class="postlist-item-excerpt">{post.data.excerpt}</div>
        <ul class="postlist-item-meta">
          <li><time datetime={post.data.created_at.toISOString()}>
            {formatter.format(post.data.created_at)}
          </time></li>
          {post.data.updated_at && (
            <li class="post-heading-meta-updated">
              Updated <time datetime={post.data.updated_at.toISOString()}>
              {formatter.format(post.data.updated_at)}</time>
            </li>
          )}
        </ul>
      </article>
    ))}
  </div>
</BaseLayout>
