---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatter } from '../../lib/date.ts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.created_at.valueOf() - a.data.created_at.valueOf()
);
---
<BaseLayout
  title='Blog'
  description='The blog of software engineer Jari Jokinen'
  type='website'
>
  <section class="section section--heading">
    <div class="container">
      <h1>Blog</h1>
    </div>
  </section>

  <div class="postlist">
    <div class="container">
      {posts.map(post => (
        <article class="postlist-item">
          <ul class="postlist-item-meta">
            <li><time datetime={post.data.created_at.toISOString()}>
              {formatter.format(post.data.created_at)}
            </time></li>
          </ul>
          <h2><a href={'/blog/' + post.id + '/'}>{post.data.title}</a></h2>
          <div class="postlist-item-excerpt">{post.data.excerpt}</div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
