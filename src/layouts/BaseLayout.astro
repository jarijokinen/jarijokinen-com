---
import { SITE } from '../config.ts';
import Meta from '../components/Meta.astro';
import type { PageMeta } from '../types.ts';

type Props = PageMeta;

const {
  title, description, type = 'website', created_at, updated_at, schema,
  hasHero = false
} = Astro.props;

const timestamp = Date.now();

const consentLoaderUrl = '/js/consent-loader.js?' + timestamp;
const cssUrl = '/css/main.css?' + timestamp;
const jsUrl = '/js/main.js?' + timestamp;
const menuItems = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' }
];

const fullTitle = Astro.url.pathname === '/' ? title : title + ' | ' + SITE.name;
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{fullTitle}</title>
    <link rel="stylesheet" href={cssUrl}>
    <script is:inline src={consentLoaderUrl}></script>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {SITE.gtmId && <script is:inline define:vars={{ gtmId: SITE.gtmId }}>
      (function(w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0];
        var j = d.createElement(s);
        var dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>}
    <Meta
      title={title}
      description={description}
      type={type}
      created_at={created_at}
      updated_at={updated_at}
      schema={schema} 
    />
  </head>
  <body class:list={{ 
    'has-hero': hasHero,
    blog: Astro.url.pathname.includes('/blog/')
  }}>
    <header class="header">
      <div class="container">
        <a class="header-logo" href="/">
          <img src="/img/logo.svg?v2" alt="[JJ]" height="25" width="25">
          {SITE.name}
        </a>
        <nav class="header-nav">
          <ul>
            {menuItems.map(({ href, label }) => {
              const isActive = Astro.url.pathname === href ||
              (href !== '/' && Astro.url.pathname.startsWith(href));

              return (
                <li class:list={{ active: isActive }}>
                  <a href={href}>{label}</a>
                </li>
              );
            })}
          </ul>
          <button class="header-nav-toggle" type="button" aria-expanded="false"
                  aria-label="Toggle navigation">
            <span></span><span></span><span></span>
          </button>
        </nav>
        <div class="header-cta">
          <a class="button" href="mailto:jari@j2digital.com">Get In Touch</a>
        </div>
      </div>
    </header>
    <main class="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <div class="footer-about">
          <div class="footer-logo">
            <img src="/img/logo.svg?v2" alt="[JJ]" height="30" width="30">
            {SITE.name}
          </div>
          <p>
            A software engineer with more than 25 years of experience in
            software development.
          </p>
        </div>
        <nav class="footer-nav">
          <div>
            <h2>About</h2>
            <ul>
              <li><a href="/about/">About Me</a></li>
              <li><a href="/blog/">Blog</a></li>
            </ul>
          </div>
          <div>
            <h2>Legal</h2>
            <ul>
              <li><a href="/privacy/">Privacy Policy</a></li>
              <li><a href="/cookies/">Cookie Policy</a></li>
              <li><a class="consent-settings" href="#">Cookie Settings</a></li>
            </ul>
          </div>
        </nav>
        <div class="footer-divider"></div>
        <div class="footer-copyright">
          <nobr>&copy; {new Date().getFullYear()} {SITE.name}.</nobr>
          <nobr>All rights reserved.</nobr>
        </div>
        <div class="footer-social">
          <ul>
            <li><a href="https://github.com/jarijokinen">GitHub</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <script src={jsUrl} defer></script>
  </body>
</html>
