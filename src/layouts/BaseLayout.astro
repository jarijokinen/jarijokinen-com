---
import { SITE } from '../config.ts';
import Meta from '../components/Meta.astro';
import type { PageMeta } from '../types.ts';

type Props = PageMeta;

const {
  title, description, type = 'website', created_at, updated_at, schema
} = Astro.props;

const timestamp = Date.now();

const consentLoaderUrl = '/js/consent-loader.js?' + timestamp;
const cssUrl = '/css/main.css?' + timestamp;
const jsUrl = '/js/main.js?' + timestamp;
const menuItems = [
  { href: '/', label: 'Home' },
  { href: '/blog/', label: 'Blog' }
];

const fullTitle = Astro.url.pathname === '/' ? title : title + ' | ' + SITE.name;
---

<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{fullTitle}</title>
    <link rel="stylesheet" href={cssUrl}>
    <script is:inline src={consentLoaderUrl}></script>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {SITE.gtmId && <script is:inline define:vars={{ gtmId: SITE.gtmId }}>
      (function(w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0];
        var j = d.createElement(s);
        var dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', gtmId);
    </script>}
    <Meta
      title={title}
      description={description}
      type={type}
      created_at={created_at}
      updated_at={updated_at}
      schema={schema} 
    />
  </head>
  <body>
    <header class="header">
      <div class="container">
        <a class="header-logo" href="/">
          <img src="/img/logo.svg" alt="[JJ]">
          {SITE.name}
        </a>
        <nav class="header-nav">
          <ul>
            {menuItems.map(({ href, label }) => {
              return (
                <li><a href={href}>{label}</a></li>
              );
            })}
          </ul>
          <button class="header-nav-toggle" type="button" aria-expanded="false"
                  aria-label="Toggle navigation">
            <span></span><span></span><span></span>
          </button>
        </nav>
        <div class="header-cta">
          <a href="mailto:jari@j2digital.com">Get In Touch</a>
        </div>
      </div>
    </header>
    <main class="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="container">
        <div class="footer-copyright">
          &copy; {new Date().getFullYear()} {SITE.name}. All rights reserved.
        </div>
        <nav class="footer-legal-nav">
          <ul>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/cookies">Cookie Policy</a></li>
            <li><a class="consent-settings" href="#">Cookie Settings</a></li>
          </ul>
        </nav>
      </div>
    </footer>
    <script src={jsUrl} defer></script>
  </body>
</html>
