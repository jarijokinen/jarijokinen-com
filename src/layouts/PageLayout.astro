---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config.ts';

interface Props {
  title: string;
}

const { frontmatter: page } = Astro.props;
---
<BaseLayout title={page.title + '|' + SITE.name}>
  <article class="page">
    <section class="page-heading">
      <div class="container">
        <h1>{page.title}</h1>
      </div>
    </section>
    <section class="page-content">
      <div class="container">
        <slot />
      </div>
    </section>
  </article>
</BaseLayout>
