---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
  };
}
const { frontmatter: page } = Astro.props;
---

<BaseLayout title={page.title} description={page.description}>
  <article class="page">
    <section class="page-heading">
      <div class="container">
        <h1>{page.title}</h1>
      </div>
    </section>
    <section class="page-content">
      <div class="container">
        <slot />
      </div>
    </section>
  </article>
</BaseLayout>
