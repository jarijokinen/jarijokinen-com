---
import BaseLayout from './BaseLayout.astro';
import { formatter } from '../lib/date.ts';
import type { PostMeta } from '../types.ts';

type Props = PostMeta;

const category = 'Development';
const { title, description, created_at, updated_at, schema } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  type='article'
  created_at={created_at}
  updated_at={updated_at}
  schema={schema}
>
  <article class="post">
    <section class="post-heading">
      <div class="container">
        <div class="post-heading-category">{category}</div>
        <h1>{title}</h1>
        <ul class="post-heading-meta">
          <li>by Jari Jokinen</li>
          <li><time datetime={created_at.toISOString()}>
            {formatter.format(created_at)}
          </time></li>
          {updated_at && (
            <li class="post-heading-meta-updated">
              Updated <time datetime={updated_at.toISOString()}>
              {formatter.format(updated_at)}</time>
            </li>
          )}
        </ul>
      </div>
    </section>
    <section class="post-content section section--light">
      <div class="container">
        <slot />
      </div>
    </section>
  </article>
</BaseLayout>
