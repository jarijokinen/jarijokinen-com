---
import BlogLayout from './BlogLayout.astro';
import { formatter } from '../lib/date.ts';

interface Props {
  title: string;
  created_at: string;
  updated_at: string;
}

const { title, created_at, updated_at } = Astro.props;
---
<BlogLayout title={title}>
  <article class="post">
    <section class="post-heading">
      <div class="container">
        <h1>{title}</h1>
        <ul class="post-heading-meta">
          <li>by Jari Jokinen</li>
          <li><time datetime={created_at}>
            {formatter.format(new Date(created_at))}
          </time></li>
          {updated_at && (
            <li class="post-heading-meta-updated">
              Updated <time datetime={updated_at}>
              {formatter.format(new Date(updated_at))}</time>
            </li>
          )}
        </ul>
      </div>
    </section>
    <section class="post-content">
      <div class="container">
        <slot />
      </div>
    </section>
  </article>
</BlogLayout>
